VITE_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Supabase anonymous keys are public client credentials. Enforce access with RLS.
VITE_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Remote installs are fail-closed. Enabling them requires an HTTPS catalog and
# a valid bundled public-key trust store. These values are public application
# configuration, not secrets.
VITE_PUBLIC_REMOTE_INSTALLS_ENABLED=false
VITE_PUBLIC_DIONE_CATALOG_URL=https://api.example.com/v1/scripts

# Optional runtime-only token for self-hosted Dione API deployments. Never inject
# this value during packaging; set it in the environment of the running app.
DIONE_API_KEY=

# Bundled publisher trust store. JSON object mapping stable publisher key IDs to
# PEM-encoded Ed25519 public keys (use \n inside JSON strings). Never place a
# private/signing key here. This is intentionally public and release-validated.
# DIONE_PUBLISHER_TRUST_STORE={"publisher-id":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"}
DIONE_PUBLISHER_TRUST_STORE=
